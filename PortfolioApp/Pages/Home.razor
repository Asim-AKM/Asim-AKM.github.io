            "Final-year project: a scalable ASP.NET Core Web API using Clean Architecture, with JWT auth (CNIC + Roll Number login) and RBAC across 4 roles. Powers 4 role-based dashboards plus a visitor portal, with SignalR real-time notifications.",
            new[] { "ASP.NET Core", "Clean Architecture", "EF Core", "Azure SQL", "Angular", "SignalR" },
            "https://github.com/Asim-AKM/ICIT-Department-Portal"),
        new(
            "User Management Web API",
            "Jan 2025",
            "A production-style REST API with full CRUD, JWT authentication, role-based authorization, Swagger/OpenAPI docs, and custom middleware for logging, error handling, and response compression.",
            new[] { "ASP.NET Core", "JWT", "REST", "Swagger" },
            "https://github.com/Asim-AKM/Asp_Dot_UserWebApi"),

             new(
            "Online Complaint Managment System",
            "April 2024",
            "The system enables citizens or users to submit complaints, track complaint progress, and communicate with administrators through a centralized complaint management workflow.",
            new[] { "ASP.NET MVC", "Entity Framework Core 3.1.32", "PostgreSQL",},
            "https://github.com/Asim-AKM/OCMS"),
    };
}
