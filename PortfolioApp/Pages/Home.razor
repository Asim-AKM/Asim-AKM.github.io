            }),
        new(
            "Full Stack .NET Developer",
            "Netrix Solutions — Dera Ismail Khan, Pakistan",
            "Nov 2024 – May 2025",
            new[]
            {
                "Built production web applications and RESTful APIs for a live e-commerce platform using ASP.NET Core, Blazor, JWT authentication, and role-based access control.",
                "Designed SQL Server and PostgreSQL schemas with EF Core, applying Repository, Unit-of-Work, and Clean Architecture patterns.",
                "Automated internal operations workflows via Windows Forms applications.",
                "Maintained code quality in an Agile team through Git branching strategies and peer code reviews."
            }),
    };

    private static readonly Project[] Projects =
    {
        new(
            "ICIT Department Portal — Backend",
