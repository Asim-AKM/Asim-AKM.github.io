@page "/"

<PageTitle>Muhammad Asim — Senior .NET Full-Stack Developer</PageTitle>

<a class="skip-link" href="#main">Skip to content</a>

<header class="topbar">
    <div class="topbar-inner">
        <a href="#top" class="brand" @onclick="CloseMenu">
            <span class="brand-mark">MA</span>
            <span class="brand-name">Muhammad Asim</span>
        </a>

        <nav class="nav-links @(_menuOpen ? "is-open" : "")" aria-label="Primary">
            <a href="#about" @onclick="CloseMenu">About</a>
            <a href="#skills" @onclick="CloseMenu">Skills</a>
            <a href="#experience" @onclick="CloseMenu">Experience</a>
            <a href="#projects" @onclick="CloseMenu">Work</a>
            <a href="#education" @onclick="CloseMenu">Education</a>
            <a href="#contact" @onclick="CloseMenu" class="nav-cta">Contact</a>
        </nav>

        <button class="menu-toggle" type="button" aria-label="Toggle navigation menu"
                aria-expanded="@_menuOpen.ToString().ToLowerInvariant()" @onclick="ToggleMenu">
            <span></span><span></span><span></span>
        </button>
    </div>
</header>

<main id="main">

    <section id="top" class="hero">
        <div class="hero-kicker">
            <span class="status-dot" aria-hidden="true"></span>
            Available for senior full-stack roles · Islamabad, Pakistan
        </div>

        <p class="hero-role">Senior .NET Full-Stack Developer</p>
        <h1>I design and ship secure, scalable products in <em>C#</em>, <em>ASP.NET Core</em>, and <em>React</em>.</h1>
        <p class="hero-lede">
            Four years building healthcare platforms, real-time systems, and enterprise APIs —
            from JWT and RBAC to SignalR, SQL Server, and pixel-accurate UIs.
        </p>

        <div class="hero-actions">
            <a class="btn btn-primary" href="#projects">Selected work</a>
            <a class="btn btn-ghost" href="mailto:asimkhanmiani9@gmail.com">Email Asim</a>
        </div>

        <dl class="stat-row">
            <div>
                <dt>Experience</dt>
                <dd>4+ years</dd>
            </div>
            <div>
                <dt>Focus</dt>
                <dd>.NET · React · APIs</dd>
            </div>
            <div>
                <dt>Domain</dt>
                <dd>Healthcare · Enterprise</dd>
            </div>
            <div>
                <dt>Based in</dt>
                <dd>Islamabad</dd>
            </div>
        </dl>
    </section>

    <section id="about" class="section">
        <div class="section-head">
            <p class="eyebrow">01 — Profile</p>
            <h2>About</h2>
        </div>
        <div class="about-grid">
            <p class="about-copy">
                Senior .NET full-stack developer with 4+ years of professional experience building
                scalable web applications using C#, ASP.NET Core, React.js, Node.js, Entity Framework Core,
                and SQL Server. I develop RESTful APIs, responsive UIs, secure authentication, real-time
                features, and database-driven products — then stay with them through performance tuning
                and production hardening.
            </p>
            <p class="about-copy muted">
                Strong in TypeScript, Redux Toolkit, Express.js, MongoDB, PostgreSQL, JWT, OAuth 2.0, and RBAC.
                I work in clean architecture, translate business requirements into maintainable systems, and
                collaborate with product, design, and engineering across the full delivery cycle.
            </p>
        </div>
    </section>

    <section id="skills" class="section">
        <div class="section-head">
            <p class="eyebrow">02 — Capabilities</p>
            <h2>Skills</h2>
        </div>

        <div class="skills-layout">
            @foreach (var group in SkillGroups)
            {
                <article class="skill-panel">
                    <h3>@group.Label</h3>
                    <p>@group.Summary</p>
                    <ul class="chip-list">
                        @foreach (var skill in group.Items)
                        {
                            <li>@skill</li>
                        }
                    </ul>
                </article>
            }
        </div>
    </section>

    <section id="experience" class="section">
        <div class="section-head">
            <p class="eyebrow">03 — Career</p>
            <h2>Experience</h2>
        </div>

        <ol class="timeline">
            @foreach (var job in Jobs)
            {
                <li class="timeline-item">
                    <div class="timeline-meta">
                        <span class="timeline-dates">@job.Dates</span>
                        <span class="timeline-org">@job.Org</span>
                    </div>
                    <div class="timeline-body">
                        <h3>@job.Title</h3>
                        <ul class="bullet-list">
                            @foreach (var point in job.Bullets)
                            {
                                <li>@point</li>
                            }
                        </ul>
                        <ul class="chip-list chip-list-quiet">
                            @foreach (var tech in job.Tech)
                            {
                                <li>@tech</li>
                            }
                        </ul>
                    </div>
                </li>
            }
        </ol>
    </section>

    <section id="projects" class="section">
        <div class="section-head">
            <p class="eyebrow">04 — Case studies</p>
            <h2>Selected work</h2>
        </div>

        <div class="project-list">
            @foreach (var project in Projects)
            {
                <article class="project-card">
                    <div class="project-index">@project.Index</div>
                    <div class="project-main">
                        <h3>@project.Title</h3>
                        <p>@project.Description</p>
                        <ul class="chip-list chip-list-quiet">
                            @foreach (var tech in project.Tech)
                            {
                                <li>@tech</li>
                            }
                        </ul>
                    </div>
                    <ul class="project-points">
                        @foreach (var point in project.Points)
                        {
                            <li>@point</li>
                        }
                    </ul>
                </article>
            }
        </div>
    </section>

    <section id="education" class="section">
        <div class="section-head">
            <p class="eyebrow">05 — Foundation</p>
            <h2>Education</h2>
        </div>
        <div class="edu-card">
            <div>
                <h3>Bachelor's Degree in Software Engineering</h3>
                <p>Gomal University, Dera Ismail Khan</p>
            </div>
            <span class="edu-dates">2019 — 2023</span>
        </div>
    </section>

    <section id="contact" class="section section-contact">
        <div class="section-head">
            <p class="eyebrow">06 — Next</p>
            <h2>Let's build something solid.</h2>
        </div>
        <p class="contact-lede">
            Open to senior .NET / React roles and product work. The fastest path is email.
        </p>

        <div class="contact-grid">
            <a class="contact-card" href="mailto:asimkhanmiani9@gmail.com">
                <span class="contact-label">Email</span>
                <span class="contact-value">asimkhanmiani9@gmail.com</span>
            </a>
            <a class="contact-card" href="tel:+923150825356">
                <span class="contact-label">Phone</span>
                <span class="contact-value">+92 315 0825356</span>
            </a>
            <a class="contact-card" href="https://linkedin.com/in/asim-khan-5317b8356" target="_blank" rel="noopener">
                <span class="contact-label">LinkedIn</span>
                <span class="contact-value">/in/asim-khan-5317b8356</span>
            </a>
            <a class="contact-card" href="https://github.com/Asim-AKM" target="_blank" rel="noopener">
                <span class="contact-label">GitHub</span>
                <span class="contact-value">github.com/Asim-AKM</span>
            </a>
        </div>
    </section>

</main>

<footer class="site-footer">
    <p>© @DateTime.Now.Year Muhammad Asim · Islamabad</p>
    <p>Built with Blazor WebAssembly</p>
</footer>

