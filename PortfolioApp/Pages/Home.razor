@page "/"

<PageTitle>Muhammad Asim — Full-Stack .NET Developer</PageTitle>

<a class="skip-link" href="#main">Skip to content</a>

<header class="topbar">
    <div class="topbar-inner">
        <a href="#top" class="brand">
            <span class="brand-dot"></span>
            <span class="brand-text">MuhammadAsim<span class="brand-ext">.cs</span></span>
        </a>

        <nav class="nav-links @(_menuOpen ? "is-open" : "")" aria-label="Primary">
            <a href="#about" @onclick="CloseMenu">About</a>
            <a href="#skills" @onclick="CloseMenu">Skills</a>
            <a href="#experience" @onclick="CloseMenu">Experience</a>
            <a href="#projects" @onclick="CloseMenu">Projects</a>
            <a href="#contact" @onclick="CloseMenu" class="nav-cta">Contact</a>
        </nav>

        <button class="menu-toggle" aria-label="Toggle navigation menu" aria-expanded="@_menuOpen.ToString().ToLower()" @onclick="ToggleMenu">
            <span></span><span></span><span></span>
        </button>
    </div>
</header>

<main id="main">

    <!-- HERO -->
    <section id="top" class="hero">
        <div class="hero-inner">
            <div class="hero-copy">
                <p class="eyebrow">// full-stack .net developer</p>
                <h1>Muhammad Meesam</h1>
                <p class="hero-lede">
                    I build production APIs and clean, testable back ends —
                    from a live social app in Denmark to a role-based
                    university portal with real-time notifications.
                </p>
                <div class="hero-actions">
                    <a class="btn btn-primary" href="#projects">View projects</a>
                    <a class="btn btn-ghost" href="files/Muhammad_Asim_Resume.docx" download>Download CV</a>
                </div>
                <ul class="hero-meta">
                    <li>📍 Islamabad, Pakistan</li>
                    <li>🟢 Open to junior / mid roles</li>
                </ul>
            </div>

            <div class="hero-visual" aria-hidden="true">
                <div class="editor-window">
                    <div class="editor-titlebar">
                        <span class="dot dot-red"></span>
                        <span class="dot dot-yellow"></span>
                        <span class="dot dot-green"></span>
                        <span class="editor-filename">MuhammadAsim.cs</span>
                    </div>
                    <pre class="editor-body"><code
><span class="ln">1</span><span class="kw">public class</span> <span class="type">MuhammadAsim</span> : <span class="type">IDeveloper</span>
<span class="ln">2</span>{
<span class="ln">3</span>    <span class="kw">public string</span> Role =&gt; <span class="str">"Full-Stack .NET Developer"</span>;
<span class="ln">4</span>    <span class="kw">public string</span>[] Stack =&gt;
<span class="ln">5</span>        [<span class="str">"C#"</span>, <span class="str">"ASP.NET Core"</span>, <span class="str">"Blazor"</span>, <span class="str">"Angular"</span>];
<span class="ln">6</span>    <span class="kw">public int</span> YearsExperience =&gt; <span class="num">1</span>;
<span class="ln">7</span>    <span class="kw">public bool</span> IsAvailable =&gt; <span class="kw">true</span><span class="cursor">&#8203;</span>;
<span class="ln">8</span>}</code></pre>
                </div>
            </div>
        </div>
    </section>

    <!-- ABOUT -->
    <section id="about" class="section">
        <p class="eyebrow">// about</p>
        <h2>Summary</h2>
        <p class="section-lede">
            Full-stack .NET developer with hands-on experience shipping production
            features on a live Denmark-based social networking app and a production
            e-commerce platform. Comfortable across the stack: ASP.NET Core APIs,
            Entity Framework Core, Clean Architecture, JWT/RBAC security, and
            Angular/Blazor front ends. Recently completed a Software Engineering
            degree and looking for a junior-to-mid .NET role to keep owning
            features end to end.
        </p>
    </section>

    <!-- SKILLS -->
    <section id="skills" class="section">
        <p class="eyebrow">// skills</p>
        <h2>Stack</h2>

        <div class="skills-grid">
            @foreach (var group in SkillGroups)
            {
                <div class="skill-card">
                    <h3>@group.Label</h3>
                    <ul class="chip-list">
                        @foreach (var skill in group.Items)
                        {
                            <li class="chip">@skill</li>
                        }
                    </ul>
                </div>
            }
        </div>
    </section>

    <!-- EXPERIENCE -->
    <section id="experience" class="section">
        <p class="eyebrow">// experience</p>
        <h2>Where I've worked</h2>

        <ol class="timeline">
            @foreach (var job in Jobs)
            {
                <li class="timeline-item">
                    <div class="timeline-marker" aria-hidden="true"></div>
                    <div class="timeline-content">
                        <div class="timeline-head">
                            <h3>@job.Title</h3>
                            <span class="timeline-dates">@job.Dates</span>
                        </div>
                        <p class="timeline-org">@job.Org</p>
                        <ul class="bullet-list">
                            @foreach (var point in job.Bullets)
                            {
                                <li>@point</li>
                            }
                        </ul>
                    </div>
                </li>
            }
        </ol>
    </section>

    <!-- PROJECTS -->
    <section id="projects" class="section">
        <p class="eyebrow">// projects</p>
        <h2>Selected work</h2>

        <div class="project-grid">
            @foreach (var project in Projects)
            {
                <article class="project-card">
                    <div class="project-card-head">
                        <h3>@project.Title</h3>
                        <span class="project-dates">@project.Dates</span>
                    </div>
                    <p class="project-desc">@project.Description</p>
                    <ul class="chip-list">
                        @foreach (var tech in project.Tech)
                        {
                            <li class="chip chip-muted">@tech</li>
                        }
                    </ul>
                    <a class="project-link" href="@project.Link" target="_blank" rel="noopener">View repository →</a>
                </article>
            }
        </div>
    </section>

    <!-- CONTACT -->
    <section id="contact" class="section section-contact">
        <p class="eyebrow">// contact</p>
        <h2>Let's work together</h2>
        <p class="section-lede">
            Open to junior and mid-level .NET roles, remote or on-site in
            Islamabad. The fastest way to reach me is email.
        </p>

        <div class="contact-grid">
            <a class="contact-card" href="mailto:asimkhanmiani9@gmail.com">
                <span class="contact-label">Email</span>
                <span class="contact-value">asimkhanmiani9@gmail.com</span>
            </a>
            <a class="contact-card" href="tel:+923150825356">
                <span class="contact-label">Phone</span>
                <span class="contact-value">+92 315 0825356</span>
            </a>
            <a class="contact-card" href="https://linkedin.com/in/asim-khan-5317b8356" target="_blank" rel="noopener">
                <span class="contact-label">LinkedIn</span>
                <span class="contact-value">/in/asim-khan-5317b8356</span>
            </a>
            <a class="contact-card" href="https://github.com/Asim-AKM" target="_blank" rel="noopener">
                <span class="contact-label">GitHub</span>
                <span class="contact-value">/Asim-AKM</span>
            </a>
        </div>
    </section>

</main>

<footer class="site-footer">
    <p>&copy; @DateTime.Now.Year Muhammad Asim. Built with Blazor WebAssembly.</p>
</footer>

@code {
    private bool _menuOpen = false;

    private void ToggleMenu() => _menuOpen = !_menuOpen;
    private void CloseMenu() => _menuOpen = false;

    private record SkillGroup(string Label, string[] Items);
    private record Job(string Title, string Org, string Dates, string[] Bullets);
    private record Project(string Title, string Dates, string Description, string[] Tech, string Link);

    private static readonly SkillGroup[] SkillGroups =
    {
        new("Core", new[] { "C#", "ASP.NET Core", "Entity Framework Core", "REST APIs", "JWT", "RBAC", "LINQ" }),
        new("Architecture", new[] { "Clean Architecture", "Repository Pattern", "Dependency Injection", "Microservices", "MVC" }),
        new("Frontend", new[] { "Blazor Server", "Angular", "Razor Pages", "Bootstrap" }),
        new("Data", new[] { "SQL Server", "PostgreSQL", "Dapper" }),
        new("Tooling", new[] { "Git / GitHub", "xUnit", "SignalR", "Swagger / OpenAPI" }),
    };

